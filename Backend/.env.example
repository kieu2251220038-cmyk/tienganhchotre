# Local Whisper configuration (free; no API key, Google Cloud project, or billing)
WHISPER_ENABLED=true
WHISPER_PYTHON=D:\tienganhchotre\Backend\.venv\Scripts\python.exe
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# OpenAI Whisper API (optional; keep the key only in Backend/.env)
OPENAI_WHISPER_ENABLED=false
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_LANGUAGE=en

# Gmail SMTP for password-reset OTP (use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Kids English <your-gmail@gmail.com>"
